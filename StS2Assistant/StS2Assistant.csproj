<?xml version="1.0" encoding="utf-8"?>
<Project Sdk="Godot.NET.Sdk/4.5.1">
  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <LangVersion>12.0</LangVersion>
    <EnableDynamicLoading>true</EnableDynamicLoading>
    <CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
    <GenerateAssemblyInfo>true</GenerateAssemblyInfo>
    <RootNamespace>StS2Assistant</RootNamespace>
    <AssemblyName>StS2Assistant</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <!-- BaseLib для StS2 моддинга -->
    <PackageReference Include="Alchyr.Sts2.BaseLib" Version="1.0.0" />
    <PackageReference Include="Alchyr.Sts2.ModAnalyzers" Version="1.0.0" PrivateAssets="all" />
    
    <!-- JSON сериализация -->
    <PackageReference Include="System.Text.Json" Version="9.0.0" />
    
    <!-- Harmony для патчинга -->
    <PackageReference Include="Lib.Harmony" Version="2.3.3" />
  </ItemGroup>

  <ItemGroup>
    <!-- Встраивание изображения мода в PCK -->
    <EmbeddedResource Include="mod_image.png" />
  </ItemGroup>
</Project>
